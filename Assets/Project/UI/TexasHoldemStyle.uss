.screen-container {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    padding: 16px;
    justify-content: space-between;
}

.hud-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    flex-wrap: wrap;
}

.hud-left-group {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.hud-right-group {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.btn-hamburger {
    font-size: 20px;
    color: rgb(212, 175, 55);
    background-color: rgba(20, 25, 22, 0.85);
    border-width: 1px;
    border-color: rgb(212, 175, 55);
    border-radius: 8px;
    padding: 6px 14px;
    margin-right: 12px;
    -unity-font-style: bold;
}

.title-label {
    font-size: 24px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    letter-spacing: 2px;
    text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.8);
    min-width: 230px;
    margin-bottom: 8px;
}

.wallet-balance-label {
    font-size: 16px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    background-color: rgba(20, 25, 22, 0.85);
    border-radius: 8px;
    padding: 8px 16px;
    border-width: 1px;
    border-color: rgb(212, 175, 55);
    margin-right: 12px;
    min-width: 120px;
    -unity-text-align: middle-center;
}

.score-board {
    background-color: rgba(20, 25, 22, 0.85);
    border-radius: 8px;
    padding: 10px 16px;
    border-width: 1px;
    border-color: rgb(212, 175, 55);
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.score-label {
    font-size: 15px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    margin: 0 8px;
}

.center-container {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    width: 100%;
    gap: 12px;
}

.info-panel {
    width: 90%;
    max-width: 700px;
    background-color: rgba(20, 25, 22, 0.9);
    border-color: rgb(212, 175, 55);
    border-width: 1px;
    border-radius: 12px;
    padding: 12px 16px;
}

.section-title {
    font-size: 18px;
    color: rgb(212, 175, 55);
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.hand-text, .community-text {
    font-size: 16px;
    color: rgb(255, 255, 255);
    white-space: normal;
}

.outcome-banner {
    background-color: rgba(20, 25, 22, 0.95);
    border-color: rgb(212, 175, 55);
    border-width: 2px;
    border-radius: 12px;
    padding: 16px 24px;
    max-width: 90%;
    width: 100%;
    min-width: 0;
    overflow: hidden;
}

.outcome-text {
    font-size: 24px;
    color: rgb(212, 175, 55);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    word-wrap: break-word;
    overflow-wrap: break-word;
    max-width: 100%;
    min-width: 0;
}

.action-container {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: 12px;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 12px;
    flex-wrap: wrap;
}

.btn-casino {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(30, 94, 58);
    border-width: 1px;
    border-color: rgb(42, 133, 82);
    border-radius: 6px;
    padding: 12px 16px;
    margin: 6px;
    flex-grow: 1;
    flex-basis: 120px;
    max-width: 200px;
}

.btn-casino:hover {
    background-color: rgb(38, 119, 74);
}

.btn-casino:active {
    background-color: rgb(22, 72, 44);
}

.btn-casino:disabled {
    background-color: rgb(43, 51, 46);
    border-color: rgb(59, 68, 63);
    color: rgb(102, 114, 107);
}

.btn-danger {
    background-color: rgb(178, 34, 34);
    border-color: rgb(210, 54, 54);
}

.btn-danger:hover {
    background-color: rgb(205, 38, 38);
}

.btn-danger:active {
    background-color: rgb(139, 26, 26);
}
