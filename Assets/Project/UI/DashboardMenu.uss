/* ---- Backdrops & Windows Frameworks ---- */
.dash-backdrop {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(10, 14, 12, 0.96);
    justify-content: center;
    align-items: center;
    padding: 12px;
}

.dash-panel {
    background-color: #121814;
    border-width: 2px;
    border-color: #d4af37;
    border-radius: 20px;
    padding: 24px;
    width: 100%;
    max-width: 540px;
    height: auto;
    justify-content: space-between;
}

/* ---- Dedicated Centered Modal Layout Structures ---- */
.dash-modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(6, 10, 8, 0.85); /* Slightly darker focus backdrop layer */
    justify-content: center;
    align-items: center;
    padding: 16px;
    width: 100%;
    height: 100%;
}

.dash-modal-window {
    background-color: #0f1411;
    border-width: 2px;
    border-color: #d4af37;
    border-radius: 16px;
    padding: 24px;
    width: 100%;
    max-width: 480px; /* Tighter modal resolution signature */
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.85);
}

.dash-modal-body {
    margin-top: 14px;
}

/* ---- Header and Layout Elements ---- */
.dash-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    border-bottom-width: 1px;
    border-color: #222d26;
    padding-bottom: 10px;
}

.dash-title {
    color: #d4af37;
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}
.text-gold { color: #d4af37; }

.btn-close-generic {
    background-color: transparent;
    color: #8899a6;
    font-size: 20px;
    border-width: 0;
    cursor: pointer;
}
.btn-close-generic:hover { color: #ffffff; scale: 1.1; }

.dash-body-content {
    flex-grow: 1;
}

/* ---- Typography & Utilities ---- */
.dash-section-subtitle {
    color: #617a6c;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin-bottom: 8px;
    text-transform: uppercase;
}

.dash-mini-title {
    color: #617a6c;
    font-size: 10px;
    -unity-font-style: bold;
    margin-bottom: 6px;
    letter-spacing: 0.5px;
}

.margin-top-md { margin-top: 18px; }
.margin-top-sm { margin-top: 12px; }

/* ---- Experience Selection Blocks ---- */
.dash-game-grid {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
}

.btn-game-card {
    flex-grow: 1;
    flex-basis: 0;
    margin: 4px;
    padding: 16px 8px;
    border-radius: 10px;
    font-size: 11px;
    -unity-font-style: bold;
    text-align: center;
}

.game-active {
    background-color: #1c3326;
    border-width: 2px;
    border-color: #2ed573;
    color: #ffffff;
}

.game-locked {
    background-color: #1a1f1c;
    border-width: 1px;
    border-color: #2d3530;
    color: #55665c;
}
.game-locked:hover {
    background-color: #222924;
    border-color: #d4af37;
    color: #cbd5e1;
}

/* ---- Cloud Account Management Containers ---- */
.dash-account-container {
    background-color: #0b0e0c;
    border-width: 1px;
    border-color: #222d26;
    border-radius: 12px;
    padding: 16px;
    width: 100%;
}

.dash-account-status {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 12px;
}

.text-muted { color: #7f8c8d; font-size: 13px; }
.text-highlight-green { color: #2ed573; font-size: 13px; -unity-font-style: bold; }

.btn-action-premium {
    background-color: #d4af37;
    color: #0a0e0b;
    font-size: 13px;
    -unity-font-style: bold;
    padding: 12px;
    border-radius: 8px;
    border-width: 0;
    width: 100%;
    letter-spacing: 0.5px;
}
.btn-action-premium:hover { background-color: #f3cf65; }

/* ---- Fluid Sub-Panel Inputs ---- */
.linking-action-block {
    width: 100%;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 8px;
    padding: 12px;
}

.linking-row-flow {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
}

.fluid-btn { flex-grow: 3; flex-basis: 0; }
.fluid-input { flex-grow: 4; flex-basis: 0; margin-right: 8px; }

.btn-sub-action {
    background-color: #1c231f;
    border-width: 1px;
    border-color: #3b4d42;
    color: #ffffff;
    border-radius: 6px;
    padding: 10px;
    font-size: 12px;
    -unity-font-style: bold;
}
.btn-sub-action:hover { background-color: #27332c; border-color: #d4af37; }

.btn-sub-action-gold { background-color: #1c3326; border-color: #2ed573; }
.btn-sub-action-gold:hover { background-color: #2ed573; color: #0a0e0b; }

.text-pin-display {
    color: #d4af37;
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    flex-grow: 2;
    flex-basis: 0;
    -unity-text-align: middle-right;
    padding-right: 4px;
}

.pin-input-field { font-size: 14px; margin: 0; }

/* ---- System Footers ---- */
.dash-footer-container {
    border-top-width: 1px;
    border-color: #222d26;
    padding-top: 14px;
    width: 100%;
    margin-top: 16px;
}

.btn-action-danger {
    background-color: #c0392b;
    color: #ffffff;
    font-size: 13px;
    -unity-font-style: bold;
    padding: 12px;
    border-radius: 8px;
    border-width: 0;
    width: 100%;
}
.btn-action-danger:hover { background-color: #e74c3c; }