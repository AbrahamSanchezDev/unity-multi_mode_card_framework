/* ---- Fullscreen Blurred Blur Backdrop ---- */
.dash-backdrop {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(10, 14, 12, 0.96);
    justify-content: center;
    align-items: center;
}

/* ---- Central Hub Panel ---- */
.dash-panel {
    background-color: #121814;
    border-width: 2px;
    border-color: #d4af37;
    border-radius: 20px;
    padding: 30px;
    width: 90%;
    max-width: 550px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
}

/* ---- Header Layout ---- */
.dash-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-bottom: 24px;
    border-bottom-width: 1px;
    border-color: #222d26;
    padding-bottom: 10px;
}

.dash-title {
    color: #d4af37;
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.btn-close-generic {
    background-color: transparent;
    color: #8899a6;
    font-size: 20px;
    border-width: 0;
    cursor: pointer;
}

.btn-close-generic:hover { color: #ffffff; scale: 1.1; }

/* ---- Section Typography ---- */
.dash-section-subtitle {
    color: #617a6c;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin-bottom: 10px;
    text-transform: uppercase;
}

.margin-top-md {
    margin-top: 24px;
}

/* ---- Game Carousel/Grid Grid Layout ---- */
.dash-game-grid {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
}

.btn-game-card {
    flex-grow: 1;
    flex-basis: 0;
    margin: 6px;
    padding: 24px 10px;
    border-radius: 12px;
    font-size: 13px;
    -unity-font-style: bold;
    text-align: center;
    white-space: normal;
}

.game-active {
    background-color: #1c3326;
    border-width: 2px;
    border-color: #2ed573;
    color: #ffffff;
}

.game-locked {
    background-color: #1a1f1c;
    border-width: 1px;
    border-color: #2d3530;
    color: #55665c;
}

.game-locked:hover {
    background-color: #222924;
    border-color: #d4af37;
    color: #cbd5e1;
}

/* ---- Account Synchronization Segment ---- */
.dash-account-container {
    background-color: #0b0e0c;
    border-width: 1px;
    border-color: #222d26;
    border-radius: 12px;
    padding: 18px;
    width: 100%;
}

.dash-account-status {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 14px;
}

.text-muted { color: #7f8c8d; font-size: 14px; }
.text-highlight-green { color: #2ed573; font-size: 14px; -unity-font-style: bold; }

.btn-action-premium {
    background-color: #d4af37;
    color: #0a0e0b;
    font-size: 14px;
    -unity-font-style: bold;
    padding: 12px;
    border-radius: 8px;
    border-width: 0;
    width: 100%;
    letter-spacing: 0.5px;
}

.btn-action-premium:hover { background-color: #f3cf65; }
.btn-action-premium:active { background-color: #bfa032; }

/* ---- Application Utility Footer ---- */
.dash-footer-container {
    border-top-width: 1px;
    border-color: #222d26;
    padding-top: 16px;
    width: 100%;
}

.btn-action-danger {
    background-color: #c0392b;
    color: #ffffff;
    font-size: 13px;
    -unity-font-style: bold;
    padding: 10px;
    border-radius: 8px;
    border-width: 0;
    width: 100%;
    letter-spacing: 0.5px;
}

.btn-action-danger:hover { background-color: #e74c3c; }
.btn-action-danger:active { background-color: #962d22; }