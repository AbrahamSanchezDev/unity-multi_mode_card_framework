<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" ExplicitBindings="true" editor-extension-mode="False">
    <Style src="project://database/Assets/Project/UI/BlackjackStyle.uss?fileID=7433441132597879392&amp;guid=d5086c7d9571c2f46bbb78e37cf40870&amp;type=3#BlackjackStyle"/>
    <ui:VisualElement name="screen-container" class="screen-container" style="padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px;">
        <ui:VisualElement class="hud-header-row">
            <ui:VisualElement name="VisualElement" class="hud-left-group">
                <ui:Button name="btn-hamburger-menu" text="☰" class="btn-hamburger"/>
                <ui:Label text="BLACKJACK TABLE" class="title-label" style="font-size: 12px; min-width: 125px;"/>
                <ui:Label name="lbl-wallet-balance" text="Balance: $100000" class="wallet-balance-label" style="min-width: 104px;"/>
            </ui:VisualElement>
            <ui:VisualElement class="hud-right-group" style="width: 100%;">
                <ui:VisualElement class="score-board" style="width: 100%; justify-content: center;">
                    <ui:Label name="dealer-score-label" text="Dealer: 0" class="score-label"/>
                    <ui:Label text="|" style="color: rgb(212, 175, 55); font-size: 16px; -unity-font-style: bold;"/>
                    <ui:Label name="player-score-label" text="Player: 0" class="score-label"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="VisualElement" class="center-container">
            <ui:VisualElement name="outcome-message-label" class="outcome-banner" style="display: none; width: 100%; height: 200%; max-width: none; padding-right: 10px; padding-left: 10px; padding-top: 10px; padding-bottom: 10px;">
                <ui:Label text="PLAYER WINS!" class="outcome-text" style="flex-shrink: 1; flex-grow: 1; width: 100%; height: 200%; margin-bottom: 0; margin-left: 0; margin-top: 0; margin-right: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="action-container">
            <ui:Button name="hit-button" text="HIT" class="btn-casino btn-hit"/>
            <ui:Button name="stand-button" text="STAND" class="btn-casino"/>
            <ui:Button name="restart-button" text="DEAL NEW HAND" class="btn-casino"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
