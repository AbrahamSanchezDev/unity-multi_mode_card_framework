<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" ExplicitBindings="true" editor-extension-mode="False">
    <Style src="project://database/Assets/Project/UI/DashboardMenu.uss?fileID=7433441132597879392&amp;guid=dc42de5be2c288a42a03b8d7c57bfe27&amp;type=3#DashboardMenu"/>
    <ui:VisualElement class="dash-backdrop">
        <ui:VisualElement class="dash-panel">
            <ui:VisualElement class="dash-header">
                <ui:Label text="CASINO DASHBOARD" class="dash-title"/>
                <ui:Button name="btn-close-dash" text="✕" class="btn-close-generic"/>
            </ui:VisualElement>
            <ui:VisualElement class="dash-body-content">
                <ui:Label text="SELECT EXPERIENCE" class="dash-section-subtitle"/>
                <ui:VisualElement class="dash-game-grid">
                    <ui:Button name="btn-game-blackjack" text="BLACKJACK (ACTIVE)" class="btn-game-card game-active"/>
                    <ui:Button name="btn-game-solitaire" text="SOLITAIRE" class="btn-game-card game-locked"/>
                    <ui:Button name="btn-game-texasholdem" text="TEXAS HOLD&apos;EM" class="btn-game-card game-locked"/>
                </ui:VisualElement>
                <ui:Label text="CROSS-PLATFORM SYNC" class="dash-section-subtitle margin-top-md"/>
                <ui:VisualElement class="dash-account-container">
                    <ui:VisualElement class="dash-account-status">
                        <ui:Label text="Account Status:" class="text-muted"/>
                        <ui:Label name="lbl-account-status" text="Guest Device Profile" class="text-highlight-green"/>
                    </ui:VisualElement>
                    <ui:Button name="btn-open-linking" text="LINK META QUEST 3 / WEBGL ACCOUNT" class="btn-action-premium"/>
                    <ui:Button name="btn-open-settings" text="GAMEPLAY SETTINGS" class="btn-action-premium margin-top-md"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="dash-footer-container">
                <ui:Button name="btn-exit-app" text="EXIT GAME APPLICATION" class="btn-action-danger"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="linking-modal-overlay" class="dash-modal-overlay" style="display: none;">
            <ui:VisualElement class="dash-modal-window">
                <ui:VisualElement class="dash-header">
                    <ui:Label text="DEVICE LINK CENTER" class="dash-title text-gold"/>
                    <ui:Button name="btn-close-modal" text="✕" class="btn-close-generic"/>
                </ui:VisualElement>
                <ui:Label text="SYNCHRONIZE PROFILES USING A 6-DIGIT SECURITY PIN" class="dash-section-subtitle"/>
                <ui:VisualElement class="dash-modal-body">
                    <ui:VisualElement class="linking-action-block">
                        <ui:Label text="OPTION A: GENERATE PAIRING CODE FROM THIS DEVICE" class="dash-mini-title"/>
                        <ui:VisualElement class="linking-row-flow">
                            <ui:Button name="btn-generate-pin" text="GET 6-DIGIT CODE" class="btn-sub-action fluid-btn"/>
                            <ui:Label name="lbl-generated-pin" text="------" class="text-pin-display"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="linking-action-block margin-top-sm">
                        <ui:Label text="OPTION B: ENTER CODE FROM EXTERNAL INSTANCE" class="dash-mini-title"/>
                        <ui:VisualElement class="linking-row-flow">
                            <ui:TextField name="txt-input-pin" max-length="6" placeholder-text="ENTER PIN DIGIT CODE" hide-placeholder-on-focus="true" class="pin-input-field fluid-input"/>
                            <ui:Button name="btn-submit-pin" text="LINK DEVICE" class="btn-sub-action btn-sub-action-gold fluid-btn"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="settings-modal-overlay" class="dash-modal-overlay" style="display: none;">
            <ui:VisualElement class="dash-modal-window">
                <ui:VisualElement class="dash-header">
                    <ui:Label text="GAMEPLAY SETTINGS" class="dash-title text-gold"/>
                    <ui:Button name="btn-close-settings-modal" text="✕" class="btn-close-generic"/>
                </ui:VisualElement>
                <ui:Label text="Select the card face generation style used during gameplay." class="dash-section-subtitle"/>
                <ui:VisualElement class="dash-modal-body">
                    <ui:VisualElement class="settings-options">
                        <ui:Button name="btn-carddisplay-fullcard" text="Full Card" class="btn-sub-action settings-option-card"/>
                        <ui:Button name="btn-carddisplay-easyread" text="Easy Read" class="btn-sub-action settings-option-card"/>
                        <ui:Button name="btn-carddisplay-imagesgirls" text="Images Girls" class="btn-sub-action settings-option-card"/>
                        <ui:Button name="btn-carddisplay-easyreadgirls" text="Easy Read Girls" class="btn-sub-action settings-option-card"/>
                        <ui:Button name="btn-carddisplay-easyreadgirls-bg" text="Easy Read Girls BG" class="btn-sub-action settings-option-card"/>
                        <ui:Button name="btn-carddisplay-fullbackground" text="Full Background" class="btn-sub-action settings-option-card"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
