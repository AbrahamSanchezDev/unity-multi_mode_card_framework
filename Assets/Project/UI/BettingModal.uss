/* ---- Full Screen Blur Backdrop ---- */
.bet-modal-backdrop {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(6, 10, 8, 0.94); /* Oscuro profundo con tinte verde casino */
    justify-content: center;
    align-items: center;
    transition-property: background-color;
    transition-duration: 0.3s;
}

/* ---- Main Card Frame ---- */
.bet-card-panel {
    background-color: #141a16;
    border-width: 2px;
    border-color: #d4af37; /* Oro pulido */
    border-radius: 16px;
    padding: 26px;
    width: 90%;
    max-width: 380px;
    align-items: center;
    /* Soft shadow simulation for premium depth */
    border-bottom-width: 4px;
}

/* ---- Typography & Headers ---- */
.bet-header-container {
    align-items: center;
    width: 100%;
    margin-bottom: 14px;
}

.bet-header-title {
    color: #d4af37; /* Forzado Oro */
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin-bottom: 4px;
}

.bet-balance-text {
    color: #a4bfae; /* Contraste suave mint-green */
    font-size: 14px;
    -unity-font-style: normal;
}

.bet-section-subtitle {
    color: #617a6c;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    width: 100%;
    text-align: center;
    margin-bottom: 6px;
}

/* ---- Digital Wager Screen Display ---- */
.bet-display-container {
    background-color: #0b0e0c;
    width: 100%;
    padding: 16px;
    border-radius: 10px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: #222d26;
    margin-bottom: 20px;
}

.bet-amount-highlight {
    color: #ffffff; /* Forzado Blanco Puro */
    font-size: 32px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
}

/* ---- Grid Layout Architectures ---- */
.bet-grid-row {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
}

.margin-top-sm {
    margin-top: 8px;
}

/* ---- Interactive Casino Chips Buttons ---- */
.btn-chip-action {
    color: #ffffff; /* Forzado texto blanco */
    border-width: 2px;
    border-radius: 8px;
    margin: 4px;
    padding: 10px 0;
    font-size: 14px;
    -unity-font-style: bold;
    flex-grow: 1;
    text-align: center;
}

/* Custom Palette per chip denomination */
.chip-10 {
    background-color: #1a3c40;
    border-color: #2b7a78;
}
.chip-100 {
    background-color: #411e1e;
    border-color: #9a3b3b;
}
.chip-1k {
    background-color: #3f2e56;
    border-color: #7a5c9f;
}

.btn-chip-action:hover {
    opacity: 0.9;
    scale: 1.03;
}

.btn-chip-action:active {
    scale: 0.97;
}

/* ---- Utility System Buttons (Reset / Max) ---- */
.btn-utility-action {
    background-color: #222624;
    border-color: #383f3b;
    color: #cbd5e1; /* Gris claro */
    border-width: 1px;
    border-radius: 6px;
    margin: 4px;
    padding: 8px 0;
    font-size: 12px;
    -unity-font-style: bold;
    flex-grow: 1;
}

.btn-utility-max {
    border-color: #d4af37;
    color: #fff2cc;
}

.btn-utility-action:hover { background-color: #2d3330; }
.btn-utility-action:active { background-color: #191c1a; }

/* ---- Action Footer & Primary Button ---- */
.bet-footer-row {
    width: 100%;
    margin-top: 22px;
}

.btn-confirm-main {
    background-color: #d4af37;
    color: #0a0e0b; /* Texto oscuro para contraste sobre oro */
    font-size: 15px;
    -unity-font-style: bold;
    padding: 12px;
    border-radius: 8px;
    border-width: 0;
    width: 100%;
    letter-spacing: 0.5px;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.btn-confirm-main:hover {
    background-color: #f3cf65;
}

.btn-confirm-main:active {
    background-color: #bfa032;
}

.btn-confirm-main:disabled {
    background-color: #2b2b2a;
    color: #555555;
    border-width: 0;
}