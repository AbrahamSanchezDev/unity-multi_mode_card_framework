<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Project/UI/TexasHoldemStyle.uss?fileID=7433441132597879392&amp;guid=7e5fafbdf0c829745ae87ff34d249cee&amp;type=3#TexasHoldemStyle"/>
    <ui:VisualElement name="screen-container" class="screen-container" style="padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px;">
        <ui:VisualElement class="hud-header-row" style="flex-grow: 1; height: 200px; flex-wrap: wrap; flex-direction: column;">
            <ui:VisualElement name="VisualElement" class="hud-left-group" style="height: auto;">
                <ui:Button name="btn-hamburger-menu" text="..." class="btn-hamburger"/>
                <ui:Label text="TEXAS HOLD&apos;EM" class="title-label" style="min-width: 125px; font-size: 12px;"/>
                <ui:Label name="lbl-wallet-balance" text="Balance: $100000" class="wallet-balance-label"/>
            </ui:VisualElement>
            <ui:VisualElement class="hud-right-group" style="flex-direction: row; justify-content: center; align-content: flex-start; aspect-ratio: auto; width: 100%; height: auto; flex-grow: 1; min-height: auto;">
                <ui:VisualElement name="VisualElement" class="score-board" style="width: 100%;">
                    <ui:Label name="lbl-round-state" text="Round: Pre-Flop" class="score-label" style="width: 100%; font-size: 12px; -unity-text-align: upper-center;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="center-container" style="display: flex; height: 245px;">
            <ui:VisualElement name="outcome-message-label" class="outcome-banner" style="display: flex; flex-grow: 1; flex-shrink: 1; flex-wrap: wrap; width: 100%; min-width: auto; align-items: center; align-self: center; height: 100%; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; max-width: none;">
                <ui:Label name="lbl-outcome" text="TEXAS HOLD&apos;EM READY" class="outcome-text" style="flex-wrap: wrap; flex-grow: 1; align-items: center; max-width: 100%; white-space: normal; min-width: 0; align-self: center;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="VisualElement" class="action-container" style="height: 200px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; flex-direction: row; font-size: 0; color: rgba(27, 27, 27, 0); background-color: rgba(0, 0, 0, 0.463);">
            <ui:Button name="btn-deal" text="NEXT ROUND" class="btn-casino" style="max-width: 133px; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px;"/>
            <ui:Button name="btn-fold" text="FOLD" class="btn-casino btn-danger" style="max-width: 133px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
            <ui:Button name="btn-restart" text="NEW HAND" class="btn-casino" style="max-width: 133px; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
