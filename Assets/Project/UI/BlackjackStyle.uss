/* ---- General Floating HUD Layout ---- */
.screen-container {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    padding: 16px;
    justify-content: space-between;
}

/* Top Header Row: Wraps seamlessly on mobile layouts */
.hud-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    flex-wrap: wrap;
}

.title-label {
    font-size: 24px;
    color: #ffffff;
    -unity-font-style: bold;
    letter-spacing: 2px;
    text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.8);
    min-width: 200px;
    margin-bottom: 8px; /* Safe margin substitution instead of row-gap */
}

/* Minimalist Upper Scoreboard */
.score-board {
    background-color: rgba(20, 25, 22, 0.85);
    border-radius: 8px;
    padding: 10px 16px;
    border-width: 1px;
    border-color: #d4af37;
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.score-label {
    font-size: 15px;
    color: #ffffff;
    -unity-font-style: bold;
    margin: 0 8px;
}

/* Floating Center Banner for Outcomes */
.center-container {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    width: 100%;
}

.outcome-banner {
    background-color: rgba(20, 25, 22, 0.95);
    border-color: #d4af37;
    border-width: 2px;
    border-radius: 12px;
    padding: 16px 24px;
    max-width: 90%;
}

.outcome-text {
    font-size: 24px;
    color: #d4af37;
    -unity-font-style: bold;
    -unity-text-align: middle-center; /* Native USS text centering alignment alignment signature */
}

/* Action Terminal Footer: Controls elastic wrapping layout safely */
.action-container {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: 12px;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 12px;
    flex-wrap: wrap;
}

/* Casino Buttons Elastic Layout Parameters */
.btn-casino {
    font-size: 14px;
    -unity-font-style: bold;
    color: #ffffff;
    background-color: #1e5e3a;
    border-width: 1px;
    border-color: #2a8552;
    border-radius: 6px;
    padding: 12px 16px;
    margin: 6px; /* Uniform margins ensure beautiful wrapping gaps without depending on row-gap */
    flex-grow: 1;
    flex-basis: 120px;
    max-width: 200px;
}

.btn-casino:hover {
    background-color: #26774a;
}

.btn-casino:active {
    background-color: #16482c;
}

.btn-hit {
    background-color: #b22222;
    border-color: #d23636;
}

.btn-hit:hover {
    background-color: #cd2626;
}

.btn-hit:active {
    background-color: #8b1a1a;
}

.btn-casino:disabled {
    background-color: #2b332e;
    border-color: #3b443f;
    color: #66726b;
}