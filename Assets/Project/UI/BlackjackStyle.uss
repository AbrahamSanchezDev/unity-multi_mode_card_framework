/* ---- Layout General de HUD Flotante ---- */
.screen-container {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0); /* ¡Totalmente transparente para ver la mesa 3D! */
    padding: 24px;
    justify-content: space-between;
}

/* Encabezado Superior (Título a la izquierda, Marcador a la derecha) */
.hud-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
}

.title-label {
    font-size: 24px;
    color: #ffffff;
    -unity-font-style: bold;
    letter-spacing: 2px;
    text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.8);
}

/* Marcador Minimalista Superior Derecho */
.score-board {
    background-color: rgba(20, 25, 22, 0.85); /* Fondo oscuro traslúcido elegante */
    border-radius: 8px;
    padding: 10px 20px;
    border-width: 1px;
    border-color: #d4af37; /* Borde dorado fino */
    flex-direction: row;
    align-items: center;
}

.score-label {
    font-size: 16px;
    color: #ffffff;
    -unity-font-style: bold;
    margin: 0 12px;
}

/* Banner de Victoria Central Flotante (Se activa al final) */
.center-container {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    pointer-events: none; /* No bloquea clics en el espacio 3D */
}

.outcome-banner {
    background-color: rgba(20, 25, 22, 0.95);
    border-color: #d4af37;
    border-width: 2px;
    border-radius: 12px;
    padding: 16px 36px;
}

.outcome-text {
    font-size: 28px;
    color: #d4af37;
    -unity-font-style: bold;
    text-align: center;
}

/* ---- Consola de Acciones Inferior Estilizada ---- */
.action-container {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 100%;
    padding: 16px;
    background-color: rgba(0, 0, 0, 0.4); /* Cintillo inferior discreto */
    border-radius: 12px;
}

.btn-casino {
    font-size: 15px;
    -unity-font-style: bold;
    color: #ffffff;
    background-color: #1e5e3a;
    border-width: 1px;
    border-color: #2a8552;
    border-radius: 6px;
    padding: 10px 24px;
    margin: 0 10px;
    min-width: 130px;
}

.btn-casino:hover {
    background-color: #26774a;
}

.btn-casino:active {
    background-color: #16482c;
}

.btn-hit {
    background-color: #b22222;
    border-color: #d23636;
}

.btn-hit:hover {
    background-color: #cd2626;
}

.btn-hit:active {
    background-color: #8b1a1a;
}

.btn-casino:disabled {
    background-color: #2b332e;
    border-color: #3b443f;
    color: #66726b;
}