<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" ExplicitBindings="true" editor-extension-mode="False">
    <Style src="project://database/Assets/Project/UI/GlobalModalStyle.uss?fileID=7433441132597879392&amp;guid=d2d884e1b923828409ce718e4c43d376&amp;type=3#GlobalModalStyle"/>
    <ui:VisualElement class="screen-container" style="background-color: rgba(14, 14, 14, 0.13);">
        <ui:VisualElement name="modal-overlay" class="modal-overlay" style="display: none;">
            <ui:VisualElement class="modal-window">
                <ui:Label name="modal-title" text="SYSTEM ALERT" class="modal-title"/>
                <ui:Label name="modal-message" text="Connecting to PlayFab cloud infrastructure..." class="modal-body"/>
                <ui:VisualElement name="modal-actions" class="modal-action-row">
                    <ui:Button name="modal-confirm-btn" text="CONFIRM" class="btn-casino"/>
                    <ui:Button name="modal-cancel-btn" text="CANCEL" class="btn-casino btn-hit"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
